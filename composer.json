{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "inertiajs/inertia-laravel": "^v2.0.2",
        "laravel/framework": "^v12.17.0",
        "laravel/sanctum": "^v4.1.1",
        "laravel/tinker": "^v2.10.1",
        "tightenco/ziggy": "^v2.5.3",
        "tucker-eric/eloquentfilter": "^3.5.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^v3.5.5",
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^v2.3.6",
        "laravel/pint": "^v1.22.1",
        "laravel/sail": "^v1.43.1",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^v8.8.0",
        "pestphp/pest": "^v3.8.2",
        "pestphp/pest-plugin-drift": "^v3.0.0",
        "pestphp/pest-plugin-laravel": "^v3.2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/globals.php",
            "app/Helpers/dates.php",
            "app/Helpers/generators.php",
            "app/Helpers/translations.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "clear": "php artisan optimize:clear",
        "helper": "composer clear && php artisan ide-helper:generate && php artisan ide-helper:models -M && php artisan ide-helper:meta",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
