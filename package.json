    "mitt": "^3.0.1",
    "pinia": "^4.0.3",
    "pluralize": "^8.0.0",
    "primevue": "^4.5.5",
    "tailwindcss-primeui": "^0.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inertiajs/vue3": "^3.7.1",
