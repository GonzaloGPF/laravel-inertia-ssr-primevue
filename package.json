    "@types/lodash-es": "^4.17.12",
    "@types/pluralize": "^0.0.33",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/devtools-api": "^8.2.1",
    "@vue/server-renderer": "^3.5.43",
